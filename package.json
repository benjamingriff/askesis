{
  "name": "askesis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm generate:check && pnpm migrations:check && pnpm audit:production",
    "dev:agent": "node scripts/dev-local.mjs agent",
    "smoke:agent:live": "pnpm --filter @askesis/agent smoke:live",
    "dev:api": "node scripts/dev-local.mjs api",
    "dev:web": "node scripts/dev-local.mjs web",
    "dev:marketing": "node scripts/dev-local.mjs marketing",
    "dev:evals": "node scripts/dev-local.mjs evals",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:login": "pnpm --filter @askesis/api verification:login",
    "dev:mcp": "node scripts/dev-local.mjs exec -- pnpm --filter @askesis/api mcp:access",
    "example:seed": "node scripts/dev-local.mjs exec -- pnpm --filter @askesis/api example:seed",
    "strava:simulate": "node scripts/dev-local.mjs exec -- pnpm --filter @askesis/api strava:simulate",
    "retention:run": "node scripts/dev-local.mjs exec -- pnpm --filter @askesis/api retention:run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:dev && pnpm -r --if-present run test",
    "test:db": "./scripts/test-db.sh",
    "test:live:upgrade": "./scripts/test-live-upgrade.sh",
    "test:agent:upgrade": "./scripts/test-agent-upgrade.sh",
    "test:performance:upgrade": "./scripts/test-performance-upgrade.sh",
    "test:multisport:upgrade": "./scripts/test-multisport-upgrade.sh",
    "test:cutover": "sh ./scripts/test-plan-cutover.sh",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "typecheck": "pnpm -r --if-present run typecheck",
    "generate:db-types": "node scripts/dev-local.mjs exec -- pnpm --filter @askesis/api generate:db-types",
    "generate:openapi": "pnpm --filter @askesis/api generate:openapi && pnpm exec openapi-typescript packages/api-client/openapi.json -o packages/api-client/src/schema.ts",
    "generate:check": "./scripts/check-generated.sh",
    "migrations:check": "./scripts/check-migrations.sh",
    "smoke": "./scripts/smoke.sh",
    "audit:production": "pnpm audit --prod --audit-level=high",
    "dev": "node scripts/dev-local.mjs",
    "dev:mobile": "node scripts/dev-local.mjs mobile",
    "dev:mobile:web": "node scripts/dev-local.mjs mobile -- --web",
    "dev:status": "node scripts/dev-local.mjs status",
    "dev:stop": "node scripts/dev-local.mjs stop",
    "dev:clean": "node scripts/dev-local.mjs clean",
    "dev:exec": "node scripts/dev-local.mjs exec",
    "test:dev": "node --test scripts/*.test.mjs",
    "dev:doctor": "node scripts/dev-local.mjs doctor",
    "dev:list": "node scripts/dev-local.mjs list"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
