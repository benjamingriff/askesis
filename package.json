{
  "name": "askesis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace @askesis/api",
    "dev:web": "npm run dev --workspace @askesis/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "generate:db-types": "npm run generate:db-types --workspace @askesis/api",
    "generate:openapi": "npm run generate:openapi --workspace @askesis/api && openapi-typescript packages/api-client/openapi.json -o packages/api-client/src/schema.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
