POSTGRES_DB=askesis
POSTGRES_USER=askesis
POSTGRES_PASSWORD=askesis
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=8080
# Host API development uses PORT; Compose publishes its API on API_PORT.
# Optional browser origin for pnpm dev:login (defaults to localhost:WEB_PORT).
# LOCAL_WEB_URL=http://localhost:8080

# hidden removes the in-app coach from the product; production for the MCP release sets hidden.
IN_APP_COACH=enabled
# Set agent to enable the private coaching worker; test is local simulation only.
CHAT_EXECUTION_MODE=unavailable
# Shared API/worker bootstrap credential; generate with: openssl rand -hex 32
AGENT_BOOTSTRAP_TOKEN=
# Coaching provider: openai or anthropic. Provider keys belong to the worker only, never the
# API or Vite; set the key for the selected provider. Leave AGENT_MODEL empty for the
# provider default (gpt-6.1-sol, or claude-opus-5-5 for anthropic).
AGENT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_MODEL=
AGENT_REASONING=medium
AGENT_API_URL=http://localhost:3000

# Clerk development instance. Never expose CLERK_SECRET_KEY to Vite/client code.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# The API receives the same publishable key as CLERK_PUBLISHABLE_KEY through Compose.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:8080,http://localhost:5173

# Optional Strava activity connection (see docs/operations/activity-connections.md).
# Create an app at https://www.strava.com/settings/api with callback domain localhost.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Encrypts provider tokens at rest; generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Optional observability. Local reporting remains disabled unless NODE_ENV=production.
LOG_LEVEL=info
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_RELEASE=

# Railway/private deployments may override the nginx API target.
API_UPSTREAM=http://api:3000

# Keep Atlas-generated migration files owned by the host user.
LOCAL_UID=1000
LOCAL_GID=1000

# Used when running Atlas directly on the host.
DATABASE_URL=postgres://askesis:askesis@localhost:5432/askesis?sslmode=disable

# Fresh local accounts stay empty; manual: pnpm example:seed --email <verified-email>
# Every environment defaults off; enable only on the API service that should seed.
# EXAMPLE_PLAN_ENABLED=true
# EXAMPLE_PLAN_EMAIL=you@example.com
