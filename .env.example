POSTGRES_DB=askesis
POSTGRES_USER=askesis
POSTGRES_PASSWORD=askesis
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=8080

# Keep Atlas-generated migration files owned by the host user.
LOCAL_UID=1000
LOCAL_GID=1000

# Used when running Atlas directly on the host.
DATABASE_URL=postgres://askesis:askesis@localhost:5432/askesis?sslmode=disable
