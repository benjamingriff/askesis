{
  "name": "@askesis/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@askesis/api-client": "workspace:*",
    "@clerk/react": "^6.12.6",
    "@sentry/react": "^10.67.0",
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "^5.1.4",
    "lucide-react": "^1.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "zod": "^4.4.3"
  }
}
