{
  "name": "@askesis/agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:live": "tsx --env-file-if-exists=../../.env src/live-smoke.ts"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "tsx": "^4.21.0"
  }
}
