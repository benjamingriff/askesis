{
  "name": "@askesis/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:db-types": "kysely-codegen --dialect postgres --url \"${DATABASE_URL:-postgres://askesis:askesis@localhost:5432/askesis}\" --out-file src/database/generated.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.12.0",
    "@hono/node-server": "^2.0.11",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.1.5",
    "hono": "^4.11.7",
    "kysely": "^0.28.9",
    "pg": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/pg": "^8.16.0",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.21.0"
  }
}
