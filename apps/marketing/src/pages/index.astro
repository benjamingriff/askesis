---
import { getImage } from 'astro:assets';
import desktopScreenshot from '../assets/app-plan.webp';
import phoneScreenshot from '../assets/app-today-phone.webp';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import type { IconName } from '../lib/icons';
import { sessions } from '../lib/sessions';
import { APP_URL, SIGN_IN_URL } from '../lib/site';

const screenshot = await getImage({
  src: desktopScreenshot,
  widths: [864, 1180, 1728, 2360],
  format: 'webp',
  quality: 90,
});

const phone = await getImage({
  src: phoneScreenshot,
  widths: [390, 780],
  format: 'webp',
  quality: 88,
});

const sessionRows = [
  sessions.filter((_, index) => index % 2 === 0),
  sessions.filter((_, index) => index % 2 === 1),
];

const floatingMarks: { icon: IconName; cls: string }[] = [
  { icon: 'waves', cls: 'hf-swim' },
  { icon: 'dumbbell', cls: 'hf-strength' },
  { icon: 'footprints', cls: 'hf-run' },
  { icon: 'bike', cls: 'hf-ride' },
  { icon: 'ship', cls: 'hf-row' },
  { icon: 'trophy', cls: 'hf-race' },
];

const sports: { icon: IconName; name: string; tag: string }[] = [
  { icon: 'footprints', name: 'Running', tag: 'threshold pace' },
  { icon: 'bike', name: 'Cycling', tag: 'FTP + RPE' },
  { icon: 'waves', name: 'Swimming', tag: 'CSS pace' },
  { icon: 'dumbbell', name: 'Strength', tag: 'reps + RIR' },
  { icon: 'ship', name: 'Hyrox', tag: 'stations + runs' },
  { icon: 'layers', name: 'Triathlon', tag: 'bricks + transitions' },
];
---

<Layout>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-grid hero-grid--lit" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="hero-float" aria-hidden="true">
      {
        floatingMarks.map((mark) => (
          <span class:list={['hero-float-mark', mark.cls]}>
            <span class="hero-float-card">
              <Icon name={mark.icon} size={40} strokeWidth={1.6} />
            </span>
          </span>
        ))
      }
    </div>

    <div class="container hero-inner">
      <a class="hero-badge" href="#coach" data-rise>
        <span class="hero-badge-tag">New</span>
        <span>Multisport plans are here</span>
        <Icon name="arrow-right" size={13} />
      </a>

      <h1 class="hero-title display">
        <span data-rise style="--d:60ms">Structured training,</span><br />
        <span data-rise style="--d:150ms">coached in</span>{' '}
        <span data-rise style="--d:240ms" class="accent-text">conversation.</span>
      </h1>

      <p class="hero-sub" data-rise style="--d:340ms">
        Plan running, cycling, swimming, strength and Hyrox in one place. Tell the coach what you're
        training for, review every change it makes, and lock the version you'll actually train on.
      </p>

      <div class="hero-actions" data-rise style="--d:440ms">
        <a href={APP_URL} class="btn btn-primary btn-lg">
          Open Askesis
          <Icon name="arrow-right" size={15} />
        </a>
        <a class="hero-secondary-link" href="#review">
          <span>See how a plan changes</span>
          <Icon class="hero-secondary-arrow" name="arrow-up-right" size={13} strokeWidth={1.7} />
        </a>
        <p class="hero-mobile-line">
          Private alpha · Works in your phone's browser · <a href={SIGN_IN_URL}>Sign in</a>
        </p>
      </div>

      <!-- The rise wrapper is separate so its animated transform does not override the preview tilt. -->
      <div data-rise style="--d:560ms">
        <div class="hero-preview">
          <figure class="hero-screenshot-frame">
            <picture>
              <source
                media="(max-width: 820px)"
                srcset={phone.srcSet.attribute}
                sizes="min(360px, calc(100vw - 64px))"
              />
              <img
                src={desktopScreenshot.src}
                srcset={`${screenshot.srcSet.attribute}, ${desktopScreenshot.src} ${desktopScreenshot.width}w`}
                sizes="(max-width: 960px) min(864px, calc(100vw - 20px)), min(1180px, calc(100vw - 60px))"
                alt="The Askesis plan view: an eight-week Hyrox build with phase timeline, weekly load chart with B, C and A races, and running and cycling training zones"
                width={desktopScreenshot.width}
                height={desktopScreenshot.height}
                loading="eager"
                decoding="async"
              />
            </picture>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Sessions ──────────────────────────────────────────────── -->
  <section id="sessions" class="sec-sessions" aria-labelledby="sessions-title">
    <div class="container">
      <div class="section-head">
        <h2 id="sessions-title">Every session, one plan.</h2>
        <p>
          Swims, rides, runs, bricks, gym circuits and Hyrox stations live side by side. Colour only
          ever means effort, so a hard ride and a hard run look equally warm.
        </p>
      </div>
    </div>

    <div class="session-carousel" aria-label="Example sessions">
      {
        sessionRows.map((row, rowIndex) => (
          <div class:list={['session-row', rowIndex === 1 && 'is-reverse']}>
            <div class="session-track">
              {[0, 1].map((groupIndex) => (
                <div
                  class="session-track-group"
                  aria-hidden={groupIndex === 1 ? 'true' : undefined}
                >
                  {row.map((session) => (
                    <div class="session-card" style={`--effort: var(--effort-${session.effort})`}>
                      <span class="session-icon">
                        <Icon name={session.icon} size={18} />
                      </span>
                      <div class="session-body">
                        <div class="session-kind">
                          {session.kind} · {session.effort}
                        </div>
                        <div class="session-title">{session.title}</div>
                        <div class="session-meta">{session.meta}</div>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="container">
      <div class="effort-legend" aria-label="Effort scale">
        {
          ['recovery', 'easy', 'steady', 'threshold', 'hard', 'max'].map((effort) => (
            <span class="effort-step" style={`--effort: var(--effort-${effort})`}>
              {effort}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Sports ────────────────────────────────────────────────── -->
  <section id="sports" class="sec-sports">
    <div class="container">
      <div class="section-head">
        <h2>Calibrated to you, sport by sport.</h2>
        <p>
          Each sport is measured the way it's actually trained. Your paces, power and swim speeds
          belong to you, not the plan, so a new test result updates every plan from today.
        </p>
      </div>

      <div class="sport-grid">
        {
          sports.map((sport) => (
            <div class="sport">
              <div class="sport-mark">
                <Icon name={sport.icon} size={20} strokeWidth={1.7} />
              </div>
              <div class="sport-meta">
                <div class="sport-name">{sport.name}</div>
                <div class="sport-tag">{sport.tag}</div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="sport-footer">
        <div class="sport-footer-item">
          <Icon name="check" size={14} strokeWidth={2} /> Mix sports in one plan, or keep it to one.
        </div>
        <div class="sport-footer-item">
          <Icon name="check" size={14} strokeWidth={2} /> Estimates are labelled until you test.
        </div>
        <div class="sport-footer-item">
          <Icon name="check" size={14} strokeWidth={2} /> Strength prescribes reps in reserve, not guesswork.
        </div>
      </div>
    </div>
  </section>

  <!-- ── Review ────────────────────────────────────────────────── -->
  <section id="review" class="sec-review">
    <div class="container review-inner">
      <div
        class="review-visual"
        role="img"
        aria-label="Illustration of the Askesis review flow: the coach updates a draft, each changed workout is badged, and you lock the new version."
      >
        <div class="draft-card tile">
          <div class="draft-head">
            <Icon name="sparkles" size={15} strokeWidth={1.7} />
            <span class="draft-title">Plan draft updated</span>
            <span class="draft-status">3 changes</span>
          </div>
          <div class="draft-meta">
            <span><Icon name="calendar-days" size={12} strokeWidth={1.7} /> Hyrox build · week 4</span>
            <span>Draft v3</span>
            <span>Based on locked v2</span>
          </div>
          <div class="draft-rows">
            <div style="--effort: var(--effort-hard)">
              <span class="draft-day">Tue</span>
              <Icon name="ship" size={14} />
              <span class="draft-name">Sled push and compromised running</span>
              <span class="change-badge">Added</span>
            </div>
            <div style="--effort: var(--effort-threshold)">
              <span class="draft-day">Fri</span>
              <Icon name="footprints" size={14} />
              <span class="draft-name">4 × 8 min at threshold</span>
              <span class="change-badge">Moved</span>
            </div>
            <div style="--effort: var(--effort-easy)">
              <span class="draft-day">Sun</span>
              <Icon name="bike" size={14} />
              <span class="draft-name">Long ride · 2h → 2h 30</span>
              <span class="change-badge">Changed</span>
            </div>
          </div>
          <div class="draft-foot">
            <span class="btn btn-ghost" style="font-size:12px;padding:6px 10px">View changes</span>
            <span class="btn btn-primary" style="font-size:12px;padding:6px 12px">
              <Icon name="lock" size={12} strokeWidth={2.2} />
              Review &amp; lock
            </span>
          </div>
        </div>
        <div class="draft-trail">
          <div class="draft-trail-dot"></div>
          <div class="draft-trail-line"></div>
          <div class="draft-trail-dot"></div>
        </div>
        <div class="locked-shell">
          <span class="locked-pill">
            <Icon name="lock" size={13} strokeWidth={2} />
            Locked v3
            <span class="locked-pill-meta">Active from Monday</span>
          </span>
        </div>
      </div>

      <div class="review-copy">
        <div class="section-head" style="margin-bottom:0">
          <h2>The coach drafts. You decide.</h2>
          <p>
            Chat is how plans change. The coach edits a draft and badges exactly what moved. Nothing
            reaches your schedule until you've reviewed it and locked the version yourself.
          </p>
          <ul class="checklist" style="margin-top:24px">
            <li>
              <Icon name="check" size={14} strokeWidth={2} /> Added, changed, moved and removed, on every
              workout
            </li>
            <li>
              <Icon name="check" size={14} strokeWidth={2} /> Locked versions never change, with full history
            </li>
            <li>
              <Icon name="check" size={14} strokeWidth={2} /> Unlock, adjust and relock when life happens
            </li>
            <li>
              <Icon name="check" size={14} strokeWidth={2} /> The coach can never lock or unlock for you
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Coach ─────────────────────────────────────────────────── -->
  <section id="coach" class="sec-coach">
    <div class="container">
      <div class="section-head coach-head">
        <div class="eyebrow">Coaching</div>
        <h2>Tell it what changed. It rewrites the week.</h2>
      </div>

      <div class="coach-grid">
        <div class="tile chat">
          <div class="chat-head">
            <span></span><span></span><span></span>
            <span class="chat-title">Coach · Hyrox build</span>
          </div>
          <div class="chat-body">
            <div class="chat-user">
              Work moved my long run to Sunday, and my knee's a bit sore after Wednesday.
            </div>
            <div class="chat-activity">
              <div><Icon name="check" size={12} strokeWidth={2.4} /> Read week 4 of Hyrox build</div>
              <div>
                <Icon name="check" size={12} strokeWidth={2.4} /> Moved <em>Long run</em> to Sunday
              </div>
              <div>
                <Icon name="check" size={12} strokeWidth={2.4} /> Swapped Thursday's intervals for a recovery
                spin
              </div>
            </div>
            <div class="chat-reply">
              Done. Sunday is your long run now, kept at easy pace. Thursday becomes a 45-minute
              recovery spin so the knee gets a break before the weekend. Review the draft when you're
              ready.
            </div>
            <div class="chat-composer">
              <span class="chat-placeholder">Ask the coach anything</span><span class="caret"></span>
            </div>
          </div>
        </div>

        <div class="tile coach-pitch">
          <ul class="coach-pitch-list">
            <li>
              <span class="coach-pitch-mark" aria-hidden="true"
                ><Icon name="flag" size={13} strokeWidth={2.2} /></span
              >
              <span
                ><strong>Briefs, not forms.</strong> Goals, races, availability and niggles go in once,
                in plain language.</span
              >
            </li>
            <li>
              <span class="coach-pitch-mark" aria-hidden="true"
                ><Icon name="message-square" size={13} strokeWidth={2.2} /></span
              >
              <span
                ><strong>Replies stream live.</strong> Conversations and committed edits survive reloads
                and dropped connections.</span
              >
            </li>
            <li>
              <span class="coach-pitch-mark" aria-hidden="true"
                ><Icon name="check" size={13} strokeWidth={2.4} /></span
              >
              <span
                ><strong>Truthful progress.</strong> Unplanned weeks and missing prescriptions are always
                visible, never papered over.</span
              >
            </li>
          </ul>

          <div class="coach-pitch-footer">
            <div class="coach-pitch-meta">
              <span>Phases · races · zones</span>
              <span aria-hidden="true">·</span>
              <span>Every version kept</span>
            </div>
            <div class="coach-pitch-actions">
              <a class="btn btn-primary" href={APP_URL}>
                Start a plan
                <Icon name="arrow-right" size={14} />
              </a>
              <a class="coach-link" href={SIGN_IN_URL}>
                Sign in
                <Icon name="arrow-up-right" size={12} strokeWidth={1.7} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────── -->
  <section id="start" class="sec-cta">
    <div class="cta-grid" aria-hidden="true"></div>
    <div class="container cta-inner">
      <h2 class="display cta-title">Your training deserves better than a spreadsheet.</h2>
      <p class="cta-sub">
        Askesis is in private alpha with friends and family. If you've been invited, sign in and tell
        the coach what you're training for.
      </p>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href={APP_URL}>
          Open Askesis
          <Icon name="arrow-right" size={15} />
        </a>
        <a class="btn btn-ghost btn-lg" href={SIGN_IN_URL}>Sign in</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { startHomeMotion } from '../lib/homeMotion';

  const hero = document.querySelector<HTMLElement>('.hero');
  const field = document.querySelector<HTMLElement>('.hero-float');
  const tracks = Array.from(document.querySelectorAll<HTMLElement>('.session-track'));
  const caret = document.querySelector<HTMLElement>('.caret');
  if (hero && field && caret) {
    startHomeMotion({ hero, field, tracks, caret });
  }
</script>

<style>
  /* ── Section base ─────────────────────────────────────────── */
  section {
    position: relative;
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .section-head {
    margin-bottom: 56px;
    max-width: 720px;
  }

  .section-head .eyebrow {
    margin-bottom: 14px;
    display: block;
  }

  .section-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 18px;
    text-wrap: balance;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .checklist li svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    padding: 56px 0 60px;
    position: relative;
    overflow: hidden;
    border-top: 0;
    --gx: 50%;
    --gy: -400px;
    --spot: 0;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
  }

  /* The same grid in Volt, revealed in a soft circle that follows the pointer. */
  .hero-grid--lit {
    background-image:
      linear-gradient(to right, rgba(200, 240, 49, 0.32) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(200, 240, 49, 0.32) 1px, transparent 1px);
    mask-image: radial-gradient(220px circle at var(--gx) var(--gy), black, transparent 100%);
    -webkit-mask-image: radial-gradient(220px circle at var(--gx) var(--gy), black, transparent 100%);
    opacity: var(--spot);
    transition: opacity 0.4s ease;
  }

  .hero-glow {
    position: absolute;
    left: 50%;
    top: 560px;
    width: min(1200px, 100vw);
    height: 720px;
    translate: -50% 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 45% at 50% 40%, rgba(200, 240, 49, 0.16), transparent 70%),
      radial-gradient(ellipse 35% 35% at 30% 55%, rgba(56, 189, 248, 0.08), transparent 70%),
      radial-gradient(ellipse 35% 35% at 70% 55%, rgba(251, 138, 60, 0.07), transparent 70%);
    filter: blur(20px);
  }

  .hero-inner {
    position: relative;
    text-align: center;
    z-index: 2;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 5px 12px 5px 5px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.025);
    color: var(--fg-muted);
    font-size: 13px;
    letter-spacing: -0.01em;
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .hero-badge:hover {
    color: var(--fg);
    border-color: var(--accent-border);
  }

  .hero-badge-tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(40px, 6vw, 80px);
    margin: 26px auto 22px;
    max-width: 18ch;
    text-wrap: balance;
  }
  /* Inline boxes ignore transforms, so each rising line needs its own block. */
  .hero-title span {
    display: inline-block;
  }

  .hero-title .accent-text {
    text-shadow: 0 0 48px rgba(200, 240, 49, 0.35);
  }

  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    max-width: 640px;
    margin: 0 auto 36px;
    letter-spacing: -0.005em;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 64px;
  }

  .hero-secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.18s ease;
  }

  .hero-secondary-link:hover {
    color: var(--fg);
  }

  .hero-secondary-link :global(.hero-secondary-arrow) {
    flex-shrink: 0;
    opacity: 0.6;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }

  .hero-secondary-link:hover :global(.hero-secondary-arrow) {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  .hero-mobile-line {
    color: var(--fg-dim);
    font-size: 13px;
    letter-spacing: -0.005em;
  }

  .hero-mobile-line a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 168, 0.4);
    text-underline-offset: 3px;
    transition:
      color 0.18s ease,
      text-decoration-color 0.18s ease;
  }

  .hero-mobile-line a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* Marks enter once, then drift while visible and lean toward the pointer. */
  .hero-float {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    --px: 0px;
    --py: 0px;
  }

  .hero-float-mark {
    position: absolute;
    left: calc(50% + var(--x));
    top: var(--y);
    width: var(--s);
    height: var(--s);
    margin-left: calc(var(--s) / -2);
    translate: calc(var(--px) * var(--depth)) calc(var(--py) * var(--depth));
    transition: translate var(--parallax-duration, 0s) cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero-float-card {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 28%;
    color: var(--fg);
    background: radial-gradient(
      circle at 30% 25%,
      var(--tint, rgba(255, 255, 255, 0.08)),
      rgba(20, 20, 22, 0.92) 65%
    );
    border: 1px solid var(--border);
    box-shadow:
      0 20px 48px -16px rgba(0, 0, 0, 0.65),
      0 2px 0 0 rgba(255, 255, 255, 0.04) inset;
    animation:
      mark-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d) both,
      mark-drift var(--dur) ease-in-out calc(var(--d) + 1s) infinite;
    animation-play-state: running, var(--home-motion-state, paused);
  }

  .hero-float-card :global(svg) {
    width: 46%;
    height: 46%;
  }

  @keyframes mark-in {
    from {
      opacity: 0;
      transform: translate(var(--fx), var(--fy)) rotate(calc(var(--rot) + 24deg)) scale(0.6);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(var(--rot)) scale(1);
    }
  }
  @keyframes mark-drift {
    0%,
    100% {
      transform: translate(0, 0) rotate(var(--rot));
    }
    50% {
      transform: translate(var(--dx), var(--dy)) rotate(calc(var(--rot) + var(--wob)));
    }
  }

